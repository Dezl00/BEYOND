# Required server environment
# All Gemini keys in ONE variable, separated by commas (no public/client prefix).
GEMINI_API_KEYS=key1,key2,key3,key4
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=
APP_PASSWORD=
APP_ENCRYPTION_KEY=

# Select the pinned pnpm version on Vercel
ENABLE_EXPERIMENTAL_COREPACK=1
